# Copy to backend/.env for local development. NEVER commit the real .env.
# On Render these are set in the dashboard (see render.yaml and docs/DEPLOY.md).

NODE_ENV=development
PORT=4000
# extra website addresses allowed to call the API (the site's own address is always allowed)
CORS_ORIGIN=http://localhost:5173
# public address of the site (on Render this defaults to the Render address)
PUBLIC_API_URL=http://localhost:4000

# Database — either one full DATABASE_URL (hosting) …
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# … or the separate fields (local PostgreSQL)
DB_NAME=mivanjari
DB_PASSWORD=
# DB_USER=postgres
# DB_HOST=localhost
# DB_PORT=5432

# Login security — long random strings (at least 32 characters each)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRY=15m
REFRESH_TOKEN_DAYS=30
COOKIE_SAMESITE=lax
OTP_TTL_MINUTES=5
# proxies in front of the server (Render: 1). Check "ip" at /api/v1/health after deploying.
TRUST_PROXY=1

# Admin login at /admin/login (email code + admin password). Keep ADMIN_PHONES empty.
ADMIN_EMAILS=mivanjari1111@gmail.com
ADMIN_PHONES=
ADMIN_SESSION_HOURS=12

# Email — members log in with a code sent by email. Use ONE of:
#  a) Brevo (free 300/day, works on every host):
BREVO_API_KEY=
#  b) Gmail SMTP with an App Password (may be blocked on some free hosts):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# sender — must be verified in Brevo (or be the Gmail account above)
MAIL_FROM="Mi Vanjari <mivanjari1111@gmail.com>"

# Optional SMS login (MSG91). Not needed — email login is free.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Photos — Cloudinary (required on free hosts; their disks are wiped on restart)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# ALLOW_LOCAL_UPLOADS=1   # only on a server with a permanent disk (VPS)

# Payments — Razorpay (test keys start with rzp_test_, live keys with rzp_live_)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
