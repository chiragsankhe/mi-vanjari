{
  "name": "@mivanjari/backend",
  "version": "1.0.0",
  "author": "Chirag Sankhe",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json src/server.js",
    "start": "node src/server.js",
    "db:create": "node scripts/create-db.js",
    "db:setup": "node scripts/create-db.js && node scripts/prisma.js migrate deploy && node scripts/prisma.js generate && node prisma/seed.js",
    "db:migrate": "node scripts/prisma.js migrate dev",
    "db:deploy": "node scripts/prisma.js migrate deploy",
    "db:generate": "node scripts/prisma.js generate",
    "db:seed": "node prisma/seed.js",
    "db:reset": "node scripts/prisma.js migrate reset --force",
    "db:studio": "node scripts/prisma.js studio",
    "db:history": "node scripts/update-history.js",
    "db:starter": "node prisma/starter.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^6.10.1",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "pino-pretty": "^13.1.1",
    "prisma": "6.19.3"
  }
}
